# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# sanity build artifact (regenerate via `bun run sanity:types`)
/schema.json

# IndexNow per-domain keys (private, not meant for git)
/scripts/.indexnow-keys.json

# typescript
*.tsbuildinfo
next-env.d.ts
.env*.local
